# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-in-production

# Database
DATABASE_URL=sqlite:///app.db

# JWT
JWT_SECRET_KEY=jwt-change-me-in-production
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_DAYS=14

# Encryption
ENCRYPTION_MASTER_KEY=change-me-32-bytes-minimum-key

# Request Signing
REQUEST_SIGNING_SECRET=change-me-signing-secret

# Rate Limiting
RATE_LIMIT_DEFAULT_PER_MINUTE=60
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15

# Booking
HOLD_EXPIRY_MINUTES=10
BOOKING_BUFFER_MINUTES=5

# Content
RATING_DEMOTION_MIN_COUNT=20
RATING_DEMOTION_THRESHOLD=2.0

# TLS
ENABLE_TLS=false

# Logging
LOG_LEVEL=INFO
